# Database (Phase 3 Postgres — same as proxy audit)
DATABASE_URL=postgres://unblock:unblock_dev@127.0.0.1:5432/unblock_audit

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Stripe (no hardcoded keys; use env in production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# Remote Policy API: key used by proxy to fetch policy (X-Proxy-API-Key)
PROXY_API_KEY=generate-secure-key-for-proxy

# Optional: base URL for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
