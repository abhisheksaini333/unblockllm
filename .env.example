# unblock-proxy environment variables. Copy to .env and set values. NO real secrets.

# OpenAI-compatible API base URL (default: https://api.openai.com)
OPENAI_BASE_URL=https://api.openai.com

# Optional: Redis URL for mapping store. If unset, in-memory store is used (single process).
# REDIS_URL=redis://localhost:6379

# Optional: PostgreSQL URL for audit logs. If unset, audit logging is disabled (no-op).
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/unblock_audit

# Path to policy YAML (default: config/policy.yaml)
POLICY_CONFIG_PATH=config/policy.yaml

# Rate limit: requests per second per peer IP (default: 1000)
RATE_LIMIT_PER_SECOND=1000

# Optional: Dashboard URL for remote policy fetch. If set, proxy polls for policy.
# DASHBOARD_URL=https://dashboard.example.com

# Required when DASHBOARD_URL is set: API key for X-Proxy-API-Key when fetching policy
# PROXY_API_KEY=generate-secure-key

# Optional: Directory for ONNX NER model (enables ONNX in addition to regex)
# NER_MODEL_DIR=/path/to/models
